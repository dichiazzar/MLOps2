# Secretos del TP integrador de MLOps2 (clase 7). Copiar a .env y cambiar los valores:
#   cp .env.example .env
# Para generar un secreto aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# El .env real NO se sube al repo (está en .gitignore).

# --- Tokens (JWT) ---
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_MINUTOS=60
LIMITE_POR_MINUTO=60

# --- Firma de los productores de streaming (una clave por concesionaria) ---
HMAC_CLAVES={"concesionaria-norte": "clave-norte-cambiar", "concesionaria-sur": "clave-sur-cambiar"}

# --- Integridad del modelo ---
# true = no se carga un modelo sin seguridad_modelo.json (producción).
# false = se carga igual con un warning (desarrollo).
EXIGIR_INTEGRIDAD=false

# --- Usuarios de MinIO por servicio (los crea seguridad-minio) ---
MINIO_CAPA_REST_USER=capa-rest
MINIO_CAPA_REST_PASSWORD=cambiar-rest-12345678
MINIO_CAPA_GRAPHQL_USER=capa-graphql
MINIO_CAPA_GRAPHQL_PASSWORD=cambiar-graphql-12345678
MINIO_CAPA_GRPC_USER=capa-grpc
MINIO_CAPA_GRPC_PASSWORD=cambiar-grpc-12345678
MINIO_CAPA_STREAMING_USER=capa-streaming
MINIO_CAPA_STREAMING_PASSWORD=cambiar-streaming-12345678
MINIO_LAKE_PREPARAR_USER=lake-preparar
MINIO_LAKE_PREPARAR_PASSWORD=cambiar-preparar-12345678
